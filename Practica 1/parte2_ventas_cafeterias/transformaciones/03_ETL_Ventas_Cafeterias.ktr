        <negated>N</negated>
        <leftvalue>DIFERENCIA</leftvalue>
        <function>&lt;=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Number</type>
          <text>0.01</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask>####0.0#########;-####0.0#########</mask>
        </value>
