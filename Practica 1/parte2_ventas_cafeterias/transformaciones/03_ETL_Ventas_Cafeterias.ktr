  <step>
    <name>Recuperar precio</name>
    <type>Janino</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>PRECIO_FINAL</field_name>
      <formula_string>PRECIO != null ? PRECIO : (PRECIO_LISTA != null ? PRECIO_LISTA : (TOTAL != null &amp;&amp; CANTIDAD != null &amp;&amp; CANTIDAD.longValue() &gt; 0 ? new Double(TOTAL.doubleValue() / CANTIDAD.longValue()) : null))</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
