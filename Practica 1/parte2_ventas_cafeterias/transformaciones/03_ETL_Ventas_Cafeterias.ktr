    </GUI>
  </step>
  <step>
    <name>Recuperar valores faltantes</name>
    <type>Janino</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>ITEM_FINAL</field_name>
      <formula_string>(ITEM != null &amp;&amp; ITEM.length() &gt; 0) ? ITEM : ITEM_POR_PRECIO</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>CANTIDAD_FINAL</field_name>
      <formula_string>CANTIDAD != null ? CANTIDAD : (TOTAL != null &amp;&amp; PRECIO_FINAL != null &amp;&amp; PRECIO_FINAL.doubleValue() &gt; 0 ? new Long(Math.round(TOTAL.doubleValue() / PRECIO_FINAL.doubleValue())) : null)</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>TOTAL_FINAL</field_name>
      <formula_string>TOTAL != null ? TOTAL : (CANTIDAD_FINAL != null &amp;&amp; PRECIO_FINAL != null ? new Double(CANTIDAD_FINAL.longValue() * PRECIO_FINAL.doubleValue()) : null)</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>CAMPOS_RECUPERADOS</field_name>
      <formula_string>((((ITEM == null || ITEM.length() == 0) &amp;&amp; ITEM_FINAL != null) ? "PRODUCTO " : "") + ((PRECIO == null &amp;&amp; PRECIO_FINAL != null) ? "PRECIO " : "") + ((CANTIDAD == null &amp;&amp; CANTIDAD_FINAL != null) ? "CANTIDAD " : "") + ((TOTAL == null &amp;&amp; TOTAL_FINAL != null) ? "TOTAL" : "")).trim()</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1950</xloc>
      <yloc>300</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
